+
+/*
+ * Carries every instance of the URBDRC dynamic channel to rdp-usb-gw over a
+ * unix socket. This file knows nothing about USB. MS-RDPEUSB needs one control
+ * instance plus one instance per device, so the bridge asks for each instance
+ * and all protocol handling stays on its side of the socket.
+ *
+ * Every frame is a header of three native-endian uint32_t values, type, channel
+ * and payload length, followed by the payload. Channel numbers are chosen by the
+ * bridge (rdp-usb-gw). A channel that is refused or closed is reported with
+ * FRAME_CLOSED. rdp-usb-gw's docs/protocol.md describes the format.
+ */
+
+#include "config.h"
+
+#include "grd-rdp-dvc-urbdrc.h"
+
+#include <errno.h>
+#include <freerdp/channels/wtsvc.h>
+#include <glib/gstdio.h>
+#include <poll.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/eventfd.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <winpr/synch.h>
+#include <winpr/wtsapi.h>
+
+#define BRIDGE_SOCKET_PATH "/run/rdp-usb-gw/channel.sock"
+#define URBDRC_CHANNEL_NAME "URBDRC"
+
+#define MAX_CHANNELS 64
+#define MAX_FRAME_PAYLOAD (16 * 1024 * 1024)
+#define OPEN_POLL_INTERVAL_MS 20
+#define OPEN_TIMEOUT_US (10 * G_USEC_PER_SEC)
+
+typedef enum _FrameType
+{
+  FRAME_OPEN = 1,   /* bridge -> session */
+  FRAME_OPENED = 2, /* session -> bridge, payload: uint32_t DVC channel id */
+  FRAME_DATA = 3,   /* both directions */
+  FRAME_CLOSE = 4,  /* bridge -> session */
+  FRAME_CLOSED = 5, /* session -> bridge */
+} FrameType;
+
+typedef struct _FrameHeader
+{
+  uint32_t type;
+  uint32_t channel;
+  uint32_t length;
+} FrameHeader;
+
+typedef struct _ProxyChannel
+{
+  uint32_t id;
+  HANDLE handle;
+  int event_fd;
+  gboolean ready;
+  int64_t open_deadline_us;
+} ProxyChannel;
+
+struct _GrdRdpDvcUrbdrc
+{
+  GrdRdpDvc parent;
+
+  HANDLE vcm;
+  gboolean started;
+
+  GThread *proxy_thread;
+  int stop_fd;
+  int bridge_fd;
+  DWORD session_id;
+
+  ProxyChannel channels[MAX_CHANNELS];
+};
+
+G_DEFINE_TYPE (GrdRdpDvcUrbdrc, grd_rdp_dvc_urbdrc,
+               GRD_TYPE_RDP_DVC)
+
+static gboolean
+send_all (int          fd,
+          const void  *buffer,
+          size_t       size,
+          int          flags)
+{
+  const char *data = buffer;
+
+  while (size > 0)
+    {
+      ssize_t sent;
+
+      sent = send (fd, data, size, flags | MSG_NOSIGNAL);
+      if (sent < 0 && errno == EINTR)
+        continue;
+      if (sent <= 0)
+        return FALSE;
+
+      data += sent;
+      size -= sent;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+recv_all (int     fd,
+          void   *buffer,
+          size_t  size)
+{
+  char *data = buffer;
+
+  while (size > 0)
+    {
+      ssize_t received;
+
+      received = recv (fd, data, size, 0);
+      if (received < 0 && errno == EINTR)
+        continue;
+      if (received <= 0)
+        return FALSE;
+
+      data += received;
+      size -= received;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+send_frame (GrdRdpDvcUrbdrc *urbdrc,
+            FrameType        type,
+            uint32_t         channel,
+            const void      *payload,
+            uint32_t         length)
+{
+  FrameHeader header = { .type = type, .channel = channel, .length = length };
+
+  if (!send_all (urbdrc->bridge_fd, &header, sizeof (header),
+                 length > 0 ? MSG_MORE : 0))
+    return FALSE;
+
+  return length == 0 ||
+         send_all (urbdrc->bridge_fd, payload, length, 0);
+}
+
+static ProxyChannel *
+find_channel (GrdRdpDvcUrbdrc *urbdrc,
+              uint32_t         id)
+{
+  int i;
+
+  for (i = 0; i < MAX_CHANNELS; ++i)
+    {
+      if (urbdrc->channels[i].handle && urbdrc->channels[i].id == id)
+        return &urbdrc->channels[i];
+    }
+
+  return NULL;
+}
+
+static void
+close_channel (ProxyChannel *channel)
+{
+  WTSVirtualChannelClose (channel->handle);
+  memset (channel, 0, sizeof (*channel));
+}
+
+static gboolean
+open_channel (GrdRdpDvcUrbdrc *urbdrc,
+              uint32_t         id)
+{
+  ProxyChannel *channel = NULL;
+  HANDLE *event_handle = NULL;
+  DWORD returned = 0;
+  HANDLE handle;
+  int i;
+
+  for (i = 0; i < MAX_CHANNELS && !channel; ++i)
+    {
+      if (!urbdrc->channels[i].handle)
+        channel = &urbdrc->channels[i];
+    }
+  if (!channel || find_channel (urbdrc, id))
+    return send_frame (urbdrc, FRAME_CLOSED, id, NULL, 0);
+
+  handle = WTSVirtualChannelOpenEx (urbdrc->session_id,
+                                    (LPSTR) URBDRC_CHANNEL_NAME,
+                                    WTS_CHANNEL_OPTION_DYNAMIC);
+  if (!handle)
+    return send_frame (urbdrc, FRAME_CLOSED, id, NULL, 0);
+
+  if (!WTSVirtualChannelQuery (handle, WTSVirtualEventHandle,
+                               (PVOID *) &event_handle, &returned))
+    {
+      WTSVirtualChannelClose (handle);
+      return send_frame (urbdrc, FRAME_CLOSED, id, NULL, 0);
+    }
+
+  channel->id = id;
+  channel->handle = handle;
+  channel->event_fd = GetEventFileDescriptor (*event_handle);
+  channel->ready = FALSE;
+  channel->open_deadline_us = g_get_monotonic_time () + OPEN_TIMEOUT_US;
+  WTSFreeMemory (event_handle);
+
+  return TRUE;
+}
+
+/* The channel manager records the client's answer, but only polling exposes it */
+static gboolean
+check_opening_channel (GrdRdpDvcUrbdrc *urbdrc,
+                       ProxyChannel    *channel)
+{
+  uint32_t id = channel->id;
+  uint32_t dvc_id;
+  BOOL *ready = NULL;
+  DWORD returned = 0;
+  gboolean is_ready;
+
+  if (!WTSVirtualChannelQuery (channel->handle, WTSVirtualChannelReady,
+                               (PVOID *) &ready, &returned))
+    {
+      g_debug ("[RDP.URBDRC] Client refused channel %u", id);
+      close_channel (channel);
+      return send_frame (urbdrc, FRAME_CLOSED, id, NULL, 0);
+    }
+
+  is_ready = *ready;
+  WTSFreeMemory (ready);
+
+  if (!is_ready)
+    {
+      if (g_get_monotonic_time () < channel->open_deadline_us)
+        return TRUE;
+
+      g_warning ("[RDP.URBDRC] Client did not answer for channel %u", id);
+      close_channel (channel);
+      return send_frame (urbdrc, FRAME_CLOSED, id, NULL, 0);
+    }
+
+  channel->ready = TRUE;
+  dvc_id = WTSChannelGetIdByHandle (channel->handle);
+
+  return send_frame (urbdrc, FRAME_OPENED, id, &dvc_id, sizeof (dvc_id));
+}
+
+static gboolean
+handle_channel_event (GrdRdpDvcUrbdrc *urbdrc,
+                      ProxyChannel    *channel)
+{
+  while (TRUE)
+    {
+      g_autofree char *data = NULL;
+      uint32_t id = channel->id;
+      ULONG size = 0;
+
+      SetLastError (ERROR_SUCCESS);
+      if (!WTSVirtualChannelRead (channel->handle, 0, NULL, 0, &size))
+        {
+          if (GetLastError () == ERROR_NO_DATA)
+            return TRUE;
+
+          /* A closed channel has a quit message at the head of its queue */
+          close_channel (channel);
+          return send_frame (urbdrc, FRAME_CLOSED, id, NULL, 0);
+        }
+
+      /* With no buffer to fill, an empty message would never leave the queue */
+      data = g_malloc (MAX (size, 1));
+      if (!WTSVirtualChannelRead (channel->handle, 0, data, MAX (size, 1),
+                                  &size))
+        return FALSE;
+
+      if (!send_frame (urbdrc, FRAME_DATA, id, data, size))
+        return FALSE;
+    }
+}
+
+static gboolean
+handle_bridge_frame (GrdRdpDvcUrbdrc *urbdrc)
+{
+  g_autofree char *payload = NULL;
+  ProxyChannel *channel;
+  FrameHeader header;
+  ULONG written = 0;
+
+  if (!recv_all (urbdrc->bridge_fd, &header, sizeof (header)))
+    return FALSE;
+  if (header.length > MAX_FRAME_PAYLOAD)
+    return FALSE;
+
+  payload = g_malloc (MAX (header.length, 1));
+  if (!recv_all (urbdrc->bridge_fd, payload, header.length))
+    return FALSE;
+
+  switch (header.type)
+    {
+    case FRAME_OPEN:
+      return open_channel (urbdrc, header.channel);
+    case FRAME_DATA:
+      channel = find_channel (urbdrc, header.channel);
+      if (!channel || !channel->ready)
+        return TRUE;
+      if (!WTSVirtualChannelWrite (channel->handle, payload, header.length,
+                                   &written))
+        g_warning ("[RDP.URBDRC] Failed to write to channel %u",
+                   header.channel);
+      return TRUE;
+    case FRAME_CLOSE:
+      channel = find_channel (urbdrc, header.channel);
+      if (channel)
+        close_channel (channel);
+      return send_frame (urbdrc, FRAME_CLOSED, header.channel, NULL, 0);
+    default:
+      g_warning ("[RDP.URBDRC] Unknown frame type %u", header.type);
+      return FALSE;
+    }
+}
+
+static gboolean
+run_proxy_iteration (GrdRdpDvcUrbdrc *urbdrc,
+                     gboolean        *stop_requested)
+{
+  struct pollfd poll_fds[MAX_CHANNELS + 2];
+  ProxyChannel *owners[MAX_CHANNELS + 2];
+  gboolean any_opening = FALSE;
+  nfds_t n_fds = 2;
+  nfds_t n;
+  int i;
+
+  poll_fds[0] = (struct pollfd) { .fd = urbdrc->stop_fd, .events = POLLIN };
+  poll_fds[1] = (struct pollfd) { .fd = urbdrc->bridge_fd, .events = POLLIN };
+
+  for (i = 0; i < MAX_CHANNELS; ++i)
+    {
+      ProxyChannel *channel = &urbdrc->channels[i];
+
+      if (!channel->handle)
+        continue;
+      if (!channel->ready)
+        {
+          any_opening = TRUE;
+          continue;
+        }
+
+      poll_fds[n_fds] = (struct pollfd) { .fd = channel->event_fd,
+                                          .events = POLLIN };
+      owners[n_fds] = channel;
+      ++n_fds;
+    }
+
+  if (poll (poll_fds, n_fds, any_opening ? OPEN_POLL_INTERVAL_MS : -1) < 0)
+    return errno == EINTR;
+
+  if (poll_fds[0].revents)
+    {
+      *stop_requested = TRUE;
+      return FALSE;
+    }
+
+  /* Client data first: a frame from the bridge may close one of these channels */
+  for (n = 2; n < n_fds; ++n)
+    {
+      if (poll_fds[n].revents && !handle_channel_event (urbdrc, owners[n]))
+        return FALSE;
+    }
+
+  if (poll_fds[1].revents && !handle_bridge_frame (urbdrc))
+    return FALSE;
+
+  for (i = 0; i < MAX_CHANNELS; ++i)
+    {
+      ProxyChannel *channel = &urbdrc->channels[i];
+
+      if (channel->handle && !channel->ready &&
+          !check_opening_channel (urbdrc, channel))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gpointer
+proxy_thread_func (gpointer data)
+{
+  GrdRdpDvcUrbdrc *urbdrc = data;
+  gboolean stop_requested = FALSE;
+  int i;
+
+  while (run_proxy_iteration (urbdrc, &stop_requested))
+    ;
+
+  for (i = 0; i < MAX_CHANNELS; ++i)
+    {
+      if (urbdrc->channels[i].handle)
+        close_channel (&urbdrc->channels[i]);
+    }
+
+  if (!stop_requested)
+    {
+      g_message ("[RDP.URBDRC] Lost connection to rdp-usb-gw");
+      grd_rdp_dvc_queue_channel_tear_down (GRD_RDP_DVC (urbdrc));
+    }
+
+  return NULL;
+}
+
+static int
+connect_to_bridge (void)
+{
+  struct sockaddr_un address = { .sun_family = AF_UNIX };
+  const char *path;
+  int fd;
+
+  path = g_getenv ("RDP_USB_GW_SOCKET");
+  if (!path)
+    path = BRIDGE_SOCKET_PATH;
+  if (strlen (path) >= sizeof (address.sun_path))
+    return -1;
+  strcpy (address.sun_path, path);
+
+  fd = socket (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd < 0)
+    return -1;
+
+  if (connect (fd, (struct sockaddr *) &address, sizeof (address)) < 0)
+    {
+      close (fd);
+      return -1;
+    }
+
+  return fd;
+}
+
+static void
+grd_rdp_dvc_urbdrc_maybe_init (GrdRdpDvc *dvc)
+{
+  GrdRdpDvcUrbdrc *urbdrc = GRD_RDP_DVC_URBDRC (dvc);
+  PULONG session_id = NULL;
+  DWORD returned = 0;
+
+  if (urbdrc->started)
+    return;
+  urbdrc->started = TRUE;
+
+  urbdrc->bridge_fd = connect_to_bridge ();
+  if (urbdrc->bridge_fd < 0)
+    {
+      g_message ("[RDP.URBDRC] rdp-usb-gw is not running, "
+                 "USB redirection is unavailable");
+      grd_rdp_dvc_queue_channel_tear_down (dvc);
+      return;
+    }
+
+  if (!WTSQuerySessionInformationA (urbdrc->vcm, WTS_CURRENT_SESSION,
+                                    WTSSessionId, (LPSTR *) &session_id,
+                                    &returned))
+    {
+      g_warning ("[RDP.URBDRC] Failed to query the session id");
+      grd_rdp_dvc_queue_channel_tear_down (dvc);
+      return;
+    }
+  urbdrc->session_id = (DWORD) *session_id;
+  WTSFreeMemory (session_id);
+
+  urbdrc->stop_fd = eventfd (0, EFD_CLOEXEC);
+  g_assert (urbdrc->stop_fd >= 0);
+
+  urbdrc->proxy_thread = g_thread_new ("URBDRC proxy", proxy_thread_func,
+                                       urbdrc);
+}
+
+GrdRdpDvcUrbdrc *
+grd_rdp_dvc_urbdrc_new (GrdSessionRdp    *session_rdp,
+                        GrdRdpDvcHandler *dvc_handler,
+                        HANDLE            vcm)
+{
+  GrdRdpDvcUrbdrc *urbdrc;
+
+  urbdrc = g_object_new (GRD_TYPE_RDP_DVC_URBDRC, NULL);
+  urbdrc->vcm = vcm;
+
+  grd_rdp_dvc_initialize_base (GRD_RDP_DVC (urbdrc),
+                               dvc_handler, session_rdp,
+                               GRD_RDP_CHANNEL_URBDRC);
+
+  return urbdrc;
+}
+
+static void
+grd_rdp_dvc_urbdrc_dispose (GObject *object)
+{
+  GrdRdpDvcUrbdrc *urbdrc = GRD_RDP_DVC_URBDRC (object);
+
+  if (urbdrc->proxy_thread)
+    {
+      uint64_t stop = 1;
+
+      if (write (urbdrc->stop_fd, &stop, sizeof (stop)) != sizeof (stop))
+        g_warning ("[RDP.URBDRC] Failed to stop the proxy thread");
+      g_clear_pointer (&urbdrc->proxy_thread, g_thread_join);
+    }
+
+  g_clear_fd (&urbdrc->stop_fd, NULL);
+  g_clear_fd (&urbdrc->bridge_fd, NULL);
+
+  G_OBJECT_CLASS (grd_rdp_dvc_urbdrc_parent_class)->dispose (object);
+}
+
+static void
+grd_rdp_dvc_urbdrc_init (GrdRdpDvcUrbdrc *urbdrc)
+{
+  urbdrc->stop_fd = -1;
+  urbdrc->bridge_fd = -1;
+}
+
+static void
+grd_rdp_dvc_urbdrc_class_init (GrdRdpDvcUrbdrcClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GrdRdpDvcClass *dvc_class = GRD_RDP_DVC_CLASS (klass);
+
+  object_class->dispose = grd_rdp_dvc_urbdrc_dispose;
+
+  dvc_class->maybe_init = grd_rdp_dvc_urbdrc_maybe_init;
+}
