From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Wed, 30 Sep 2026 23:36:16 +0200
Subject: [PATCH] session/vnc: Add getter for the socket connection

This will be used for tracking sessions from connections in a later
commit.

Part-of: <https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/merge_requests/436>
(cherry picked from commit a66d55a5d85f591b2acf83d65c011d4c0a45a172)
(cherry picked from commit 02a4f22af20177e36a7a1d5d1c03db7b67dc328d)
---
 src/grd-session-vnc.c | 6 ++++++
 src/grd-session-vnc.h | 2 ++
 2 files changed, 8 insertions(+)

diff --git a/src/grd-session-vnc.c b/src/grd-session-vnc.c
index 377d769..9c0ae27 100644
--- a/src/grd-session-vnc.c
+++ b/src/grd-session-vnc.c
@@ -637,6 +637,12 @@ grd_session_vnc_get_server (GrdSessionVnc *session_vnc)
   return session_vnc->server;
 }
 
+GSocketConnection *
+grd_session_vnc_get_socket_connection (GrdSessionVnc *session_vnc)
+{
+  return session_vnc->connection;
+}
+
 static void
 init_vnc_session (GrdSessionVnc *session_vnc)
 {
diff --git a/src/grd-session-vnc.h b/src/grd-session-vnc.h
index d501950..625cb93 100644
--- a/src/grd-session-vnc.h
+++ b/src/grd-session-vnc.h
@@ -67,3 +67,5 @@ gboolean grd_session_vnc_is_client_gone (GrdSessionVnc *session_vnc);
 void grd_session_vnc_notify_error (GrdSessionVnc *session_vnc);
 
 GrdVncServer * grd_session_vnc_get_server (GrdSessionVnc *session_vnc);
+
+GSocketConnection * grd_session_vnc_get_socket_connection (GrdSessionVnc *session_vnc);
-- 
