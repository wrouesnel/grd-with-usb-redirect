From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Will Rouesnel <wrouesnel@wrouesnel.com>
Date: Thu, 19 Nov 2026 23:29:56 +1100
Subject: [PATCH] ctl: Fix reading credentials from a pipe

grdctl made a new buffered stream on stdin for every prompt. When stdin
is a pipe, the first stream can read both the username and the password
in one go, and the second prompt finds nothing left and gets end of
input.

g_data_input_stream_read_line_utf8() returns NULL without an error at
end of input, and the caller then crashed printing the missing error's
message.

Share one stream between the prompts, and report end of input as an
error.

(cherry picked from commit 1525a3fa1e9cf80e0a0ff66958e5585f7470afe2)
(cherry picked from commit 1e6fa94a41e9800adb1204807ad93a3cec8d0a8d)
---
 src/grd-ctl.c | 40 ++++++++++++++++++++++++++++++++++------
 1 file changed, 34 insertions(+), 6 deletions(-)

diff --git a/src/grd-ctl.c b/src/grd-ctl.c
index 5e225fb..ba20ea2 100644
--- a/src/grd-ctl.c
+++ b/src/grd-ctl.c
@@ -331,14 +331,31 @@ rdp_set_tls_key (GrdSettings  *settings,
   return TRUE;
 }
 
+static GDataInputStream *
+get_stdin_stream (void)
+{
+  static GDataInputStream *data_input_stream = NULL;
+
+  /* The stream buffers what it reads, and a pipe can deliver several
+   * lines in one read, so every prompt has to share one stream. */
+  if (!data_input_stream)
+    {
+      g_autoptr (GInputStream) input_stream = NULL;
+
+      input_stream = g_unix_input_stream_new (STDIN_FILENO, FALSE);
+      data_input_stream = g_data_input_stream_new (input_stream);
+    }
+
+  return data_input_stream;
+}
+
 static char *
 prompt_for_input (const char  *prompt,
                   PromptType   prompt_type,
                   GError     **error)
 {
-  g_autoptr (GInputStream) input_stream = NULL;
   g_autoptr (GOutputStream) output_stream = NULL;
-  g_autoptr (GDataInputStream) data_input_stream = NULL;
+  g_autoptr (GError) local_error = NULL;
   gboolean terminal_attributes_changed = FALSE;
   struct termios terminal_attributes;
   g_autofree char *input = NULL;
@@ -349,9 +366,6 @@ prompt_for_input (const char  *prompt,
   input_fd = STDIN_FILENO;
   output_fd = STDOUT_FILENO;
 
-  input_stream = g_unix_input_stream_new (input_fd, FALSE);
-  data_input_stream = g_data_input_stream_new (input_stream);
-
   if (isatty (output_fd))
     output_stream = g_unix_output_stream_new (output_fd, FALSE);
 
@@ -389,7 +403,8 @@ prompt_for_input (const char  *prompt,
         }
     }
 
-  input = g_data_input_stream_read_line_utf8 (data_input_stream, NULL, NULL, error);
+  input = g_data_input_stream_read_line_utf8 (get_stdin_stream (), NULL, NULL,
+                                              &local_error);
 
   if (terminal_attributes_changed)
     {
@@ -397,6 +412,19 @@ prompt_for_input (const char  *prompt,
       tcsetattr (input_fd, TCSANOW, &terminal_attributes);
     }
 
+  if (local_error)
+    {
+      g_propagate_error (error, g_steal_pointer (&local_error));
+      return NULL;
+    }
+
+  if (!input)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   "Unexpected end of input");
+      return NULL;
+    }
+
   return g_steal_pointer (&input);
 }
 
