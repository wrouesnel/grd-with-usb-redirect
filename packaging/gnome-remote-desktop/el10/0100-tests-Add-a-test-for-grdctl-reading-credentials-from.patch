From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Will Rouesnel <wrouesnel@wrouesnel.com>
Date: Thu, 19 Nov 2026 23:27:30 +1100
Subject: [PATCH] tests: Add a test for grdctl reading credentials from a pipe

grdctl prompts for the RDP username and password when they aren't on
the command line. Scripts answer those prompts on stdin, which then
isn't a terminal.

Check that piping both values in stores them, and that input which ends
before the password makes grdctl fail with an error.

This test fails: grdctl crashes in both cases.

(cherry picked from commit 837e44cfa7445d7f1fd0b77985e9607fcfa2cf64)
(cherry picked from commit d2babbb21245d46f3061963397510f55266d5f45)
(cherry picked from commit a0b7b22fc3bd596c8f5cb1070259c708fa1e081d)
---
 src/meson.build      | 38 +++++++++++++++++++-------------------
 tests/grdctl-test.sh | 38 ++++++++++++++++++++++++++++++++++++++
 tests/meson.build    | 12 ++++++++++++
 3 files changed, 69 insertions(+), 19 deletions(-)
 create mode 100755 tests/grdctl-test.sh

diff --git a/src/meson.build b/src/meson.build
index 245aceb..62b1964 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -403,11 +403,11 @@ executable('gnome-remote-desktop-control',
            include_directories: [configinc],
            install : false)
 
-executable('grdctl',
-           ctl_sources,
-           dependencies: ctl_deps,
-           include_directories: [configinc],
-           install: true)
+grdctl = executable('grdctl',
+                    ctl_sources,
+                    dependencies: ctl_deps,
+                    include_directories: [configinc],
+                    install: true)
 
 if have_rdp
   executable('gnome-remote-desktop-enable-service',
@@ -459,20 +459,20 @@ if have_rdp
                  install: true)
 endif
 
-custom_target('gsettings-enums',
-              input: 'grd-enums.h',
-              output: 'org.gnome.desktop.remote-desktop.enums.xml',
-              install: true,
-              install_dir: schemadir,
-              capture: true,
-              command: ['glib-mkenums',
-                '--comments', '<!-- @comment@ -->',
-                '--fhead', '<schemalist>',
-                '--vhead', '  <@type@ id="org.gnome.desktop.remote-desktop.@EnumName@">',
-                '--vprod', '    <value nick="@valuenick@" value="@valuenum@"/>',
-                '--vtail', '  </@type@>',
-                '--ftail', '</schemalist>',
-                '@INPUT@'])
+gsettings_enums = custom_target('gsettings-enums',
+                                input: 'grd-enums.h',
+                                output: 'org.gnome.desktop.remote-desktop.enums.xml',
+                                install: true,
+                                install_dir: schemadir,
+                                capture: true,
+                                command: ['glib-mkenums',
+                                  '--comments', '<!-- @comment@ -->',
+                                  '--fhead', '<schemalist>',
+                                  '--vhead', '  <@type@ id="org.gnome.desktop.remote-desktop.@EnumName@">',
+                                  '--vprod', '    <value nick="@valuenick@" value="@valuenum@"/>',
+                                  '--vtail', '  </@type@>',
+                                  '--ftail', '</schemalist>',
+                                  '@INPUT@'])
 schema = 'org.gnome.desktop.remote-desktop.gschema.xml'
 generated_schema = configure_file(output: schema,
                                   input: schema + '.in',
diff --git a/tests/grdctl-test.sh b/tests/grdctl-test.sh
new file mode 100755
index 0000000..fd33663
--- /dev/null
+++ b/tests/grdctl-test.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env sh
+# grdctl prompts for the RDP username and password when they aren't given as
+# arguments. Check that it reads them from stdin when stdin isn't a terminal,
+# and that it fails cleanly when the input ends early.
+
+set -e
+
+grdctl=$1
+schema_dir=$2
+
+tmpdir=$(mktemp -d --tmpdir grdctl-test-XXXXXX)
+trap 'rm -rf "$tmpdir"' EXIT
+
+export HOME="$tmpdir/home"
+export XDG_CONFIG_HOME="$HOME/.config"
+export XDG_DATA_HOME="$HOME/.local/share"
+export GSETTINGS_BACKEND=memory
+export GSETTINGS_SCHEMA_DIR="$tmpdir/schemas"
+mkdir -p "$HOME" "$GSETTINGS_SCHEMA_DIR"
+cp "$schema_dir"/org.gnome.desktop.remote-desktop.*xml "$GSETTINGS_SCHEMA_DIR"
+glib-compile-schemas "$GSETTINGS_SCHEMA_DIR"
+
+printf 'alice\nsecret\n' | "$grdctl" --headless rdp set-credentials
+
+status=$("$grdctl" --headless status --show-credentials)
+echo "$status"
+echo "$status" | grep -q 'Username: alice'
+echo "$status" | grep -q 'Password: secret'
+
+set +e
+printf 'alice\n' | "$grdctl" --headless rdp set-credentials 2> "$tmpdir/stderr"
+ret=$?
+set -e
+cat "$tmpdir/stderr"
+if [ "$ret" -ne 1 ]; then
+  echo "grdctl exited with $ret on early end of input, expected 1"
+  exit 1
+fi
diff --git a/tests/meson.build b/tests/meson.build
index 861d831..6cd81ca 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -15,6 +15,18 @@ add_test_setup('default',
 
 assert(have_rdp or have_vnc)
 
+if have_rdp
+  test('grdctl', sh,
+    args: [
+      files('grdctl-test.sh'),
+      grdctl.full_path(),
+      fs.parent(generated_schema.full_path()),
+    ],
+    depends: [grdctl, gsettings_enums],
+    is_parallel: false,
+  )
+endif
+
 
 pipewire_test_runner = find_program('pipewire-test-runner.sh', required: true)
 pipewire = find_program('pipewire', required: true)
