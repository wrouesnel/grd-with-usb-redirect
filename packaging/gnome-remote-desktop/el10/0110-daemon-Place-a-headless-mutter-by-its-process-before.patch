From fbdad02c699c7240b84037bcf5563237f8ffe42d Mon Sep 17 00:00:00 2001
From: Will Rouesnel <wrouesnel@wrouesnel.com>
Date: Mon, 23 Nov 2026 22:35:55 +1100
Subject: [PATCH] daemon: Place a headless mutter by its process before its
 user

Refusing every mutter of a user who has a graphical session on a seat
also refused a headless shell in its own seatless logind session, such as
one started by a system unit with PAMName= on a private session bus, while
the same user was logged in on the console.

Look up the session of the name owner's process first. A mutter in a
graphical session with a seat is the console's and is refused; one in any
other session is allowed. Only a mutter in no session, such as a shell run
by the user's service manager, falls back to the per-user rule. The log
line now says which rule refused it.
---
 src/grd-daemon.c | 102 +++++++++++++++++++++++++++++++++++++----------
 1 file changed, 80 insertions(+), 22 deletions(-)

diff --git a/src/grd-daemon.c b/src/grd-daemon.c
index f875447..454cc0d 100644
--- a/src/grd-daemon.c
+++ b/src/grd-daemon.c
@@ -739,12 +739,50 @@ on_mutter_screen_cast_proxy_acquired (GObject      *object,
   g_signal_emit (daemon, signals[MUTTER_PROXY_ACQUIRED], 0);
 }
 
+#ifdef HAVE_LIBSYSTEMD
+static gboolean
+get_graphical_seat (const char  *session,
+                    char       **seat_out)
+{
+  g_autofree char *seat = NULL;
+  g_autofree char *type = NULL;
+
+  if (sd_session_get_seat (session, &seat) < 0 || !seat || !*seat)
+    return FALSE;
+  if (sd_session_get_type (session, &type) < 0 ||
+      (g_strcmp0 (type, "wayland") != 0 && g_strcmp0 (type, "x11") != 0))
+    return FALSE;
+
+  *seat_out = g_steal_pointer (&seat);
+  return TRUE;
+}
+
+static GVariant *
+call_bus_method (GDBusConnection  *connection,
+                 const char       *method,
+                 const char       *name_owner,
+                 GError          **error)
+{
+  return g_dbus_connection_call_sync (connection,
+                                      "org.freedesktop.DBus",
+                                      "/org/freedesktop/DBus",
+                                      "org.freedesktop.DBus",
+                                      method,
+                                      g_variant_new ("(s)", name_owner),
+                                      G_VARIANT_TYPE ("(u)"),
+                                      G_DBUS_CALL_FLAGS_NONE,
+                                      -1, NULL, error);
+}
+#endif /* HAVE_LIBSYSTEMD */
+
 /*
- * A headless daemon shares only headless sessions. A user's console session
- * runs on the same session bus as their headless session, and with systemd
- * its shell runs in the user's service manager rather than in the session, so
- * the mutter found on the bus can't be traced to a session. Instead, never
- * share the user's mutter while they have a graphical session on a seat.
+ * A headless daemon shares only headless sessions, never a console's. A
+ * mutter whose process is in a logind session is placed by that session: it
+ * is the console's if the session is graphical and has a seat. With systemd,
+ * though, a shell can run in the user's service manager rather than in any
+ * session, and a console session's shell is then on the same session bus as
+ * a headless one. Such a mutter can't be placed, so it isn't shared while
+ * its user has a graphical session on a seat.
  */
 static gboolean
 is_name_owner_allowed (GrdDaemon       *daemon,
@@ -757,6 +795,9 @@ is_name_owner_allowed (GrdDaemon       *daemon,
   g_autoptr (GVariant) result = NULL;
   g_autoptr (GError) error = NULL;
   g_auto (GStrv) sessions = NULL;
+  g_autofree char *session = NULL;
+  g_autofree char *seat = NULL;
+  uint32_t pid;
   uint32_t uid;
   int n_sessions;
   int i;
@@ -764,15 +805,35 @@ is_name_owner_allowed (GrdDaemon       *daemon,
   if (grd_context_get_runtime_mode (priv->context) != GRD_RUNTIME_MODE_HEADLESS)
     return TRUE;
 
-  result = g_dbus_connection_call_sync (connection,
-                                        "org.freedesktop.DBus",
-                                        "/org/freedesktop/DBus",
-                                        "org.freedesktop.DBus",
-                                        "GetConnectionUnixUser",
-                                        g_variant_new ("(s)", name_owner),
-                                        G_VARIANT_TYPE ("(u)"),
-                                        G_DBUS_CALL_FLAGS_NONE,
-                                        -1, NULL, &error);
+  result = call_bus_method (connection, "GetConnectionUnixProcessID",
+                            name_owner, &error);
+  if (result)
+    {
+      g_variant_get (result, "(u)", &pid);
+      g_clear_pointer (&result, g_variant_unref);
+
+      if (sd_pid_get_session ((pid_t) pid, &session) >= 0)
+        {
+          if (get_graphical_seat (session, &seat))
+            {
+              g_warning ("Not using %s: its process %u is in graphical "
+                         "session %s on seat %s, and a headless server "
+                         "shares only headless sessions",
+                         name, pid, session, seat);
+              return FALSE;
+            }
+          return TRUE;
+        }
+    }
+  else
+    {
+      g_debug ("Can't find the process that owns %s: %s",
+               name, error->message);
+      g_clear_error (&error);
+    }
+
+  result = call_bus_method (connection, "GetConnectionUnixUser",
+                            name_owner, &error);
   if (!result)
     {
       g_warning ("Not using %s: can't tell whose it is: %s",
@@ -791,21 +852,18 @@ is_name_owner_allowed (GrdDaemon       *daemon,
 
   for (i = 0; i < n_sessions; i++)
     {
-      g_autofree char *seat = NULL;
-      g_autofree char *type = NULL;
       g_autofree char *state = NULL;
 
-      if (sd_session_get_seat (sessions[i], &seat) < 0 || !seat || !*seat)
-        continue;
-      if (sd_session_get_type (sessions[i], &type) < 0 ||
-          (g_strcmp0 (type, "wayland") != 0 && g_strcmp0 (type, "x11") != 0))
+      g_clear_pointer (&seat, g_free);
+      if (!get_graphical_seat (sessions[i], &seat))
         continue;
       if (sd_session_get_state (sessions[i], &state) >= 0 &&
           g_strcmp0 (state, "closing") == 0)
         continue;
 
-      g_warning ("Not using %s: user %u has graphical session %s on seat %s, "
-                 "and a headless server shares only headless sessions",
+      g_warning ("Not using %s: its process isn't in a session, so it may be "
+                 "the console's, and user %u has graphical session %s on "
+                 "seat %s. A headless server shares only headless sessions",
                  name, uid, sessions[i], seat);
       return FALSE;
     }
-- 
2.53.0

