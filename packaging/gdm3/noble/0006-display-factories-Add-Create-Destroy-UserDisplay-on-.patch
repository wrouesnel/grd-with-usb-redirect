 daemon/gdm-display-factory.h          |   9 ++
 daemon/gdm-local-display-factory.c    |  84 +++++++++++++
 daemon/gdm-local-display-factory.xml  |   6 +
 daemon/gdm-remote-display-factory.c   |  90 +++++++++++++-
 daemon/gdm-remote-display-factory.xml |   6 +
 daemon/meson.build                    |   1 +
 data/meson.build                      |  14 +++
 data/org.gnome.displaymanager.policy  |  20 +++
 data/polkit-gdm.rules.in              |   8 ++
 meson.build                           |   1 +
 11 files changed, 409 insertions(+), 1 deletion(-)
 create mode 100644 data/org.gnome.displaymanager.policy
